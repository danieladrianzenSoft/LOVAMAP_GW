<https://lovamap.com/ontology#fabrication-method/10.2106-jbjs.15.01273/pegpps-coating> a lova:FabricationMethod ;
    dc:source <https://lovamap.com/ontology#paper/10.2106-jbjs.15.01273> ;
    rdfs:label "Coating of titanium Kirschner wires with antibiotic-loaded PEG-PPS via wet-dry dip coating" ;
    lova:chemistry "Silane surface functionalization followed by physical encapsulation of PEG-PPS polymer" ;
    lova:manufacturingMethod "Oxygen plasma treatment, silanization, repeated dip-coating (wet-dry cycling, 10 cycles)" ;
    lova:annealingConditions "Submerged in coating solution at 4°C, dried at 50°C, 10 repeated cycles" ;
