<https://lovamap.com/ontology#fabrication-method/10.1002-cmdc.201000541/dota-pei-rgd-polyplex> a lova:FabricationMethod ;
    dc:source <https://lovamap.com/ontology#paper/10.1002-cmdc.201000541> ;
    rdfs:label "DOTA-PEI 64Cu labeling, polyplex self-assembly, and RGD nanocluster surface modification" ;
    lova:chemistry "NHS-ester amide coupling (DOTA conjugation); electrostatic polyplex self-assembly; UV-activated photocrosslinking (NHS-ASA)" ;
    lova:manufacturingMethod "Polyplex self-assembly (electrostatic complexation) with gold-nanoparticle RGD nanocluster surface conjugation" ;
    lova:annealingChemistry "UV-activated heterobifunctional crosslinker (NHS-ASA) conjugation of Cap-RGD peptide to polyplex surface" ;
    lova:annealingConditions "Ambient light exposure, 15 min" ;
    lova:hasReagent <https://lovamap.com/ontology#reagent/10.1002-cmdc.201000541/b-pei> ,
                    <https://lovamap.com/ontology#reagent/10.1002-cmdc.201000541/dota-nhs> ,
                    <https://lovamap.com/ontology#reagent/10.1002-cmdc.201000541/cu64> ,
                    <https://lovamap.com/ontology#reagent/10.1002-cmdc.201000541/plasmid-dna> ,
                    <https://lovamap.com/ontology#reagent/10.1002-cmdc.201000541/cap-peptide> ,
                    <https://lovamap.com/ontology#reagent/10.1002-cmdc.201000541/cap-rgd-peptide> ,
                    <https://lovamap.com/ontology#reagent/10.1002-cmdc.201000541/nhs-asa> ,
                    <https://lovamap.com/ontology#reagent/10.1002-cmdc.201000541/gold-nanoparticles> ,
                    <https://lovamap.com/ontology#reagent/10.1002-cmdc.201000541/chelex-100> ,
                    <https://lovamap.com/ontology#reagent/10.1002-cmdc.201000541/ammonium-acetate> .

