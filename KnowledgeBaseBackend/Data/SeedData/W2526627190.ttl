<https://lovamap.com/ontology#fabrication-method/10.1039-c6cc05099a/pah-peg-disulfide-crosslinking> a lova:FabricationMethod ;
    dc:source <https://lovamap.com/ontology#paper/10.1039-c6cc05099a> ;
    rdfs:label "PAH-PEG-thiol self-crosslinkable polymer vector for protein nanoencapsulation" ;
    lova:chemistry "Electrostatic self-assembly followed by disulfide (thiol oxidation) crosslinking" ;
    lova:manufacturingMethod "In situ growth of polymer shell around individual protein molecules via electrostatic assembly and oxidative thiol crosslinking (radical-free)" ;
    lova:annealingChemistry "Disulfide bond formation via oxidation of thiol moieties introduced by Traut's reagent" ;
    lova:hasReagent <https://lovamap.com/ontology#reagent/10.1039-c6cc05099a/pah> ,
                    <https://lovamap.com/ontology#reagent/10.1039-c6cc05099a/peg-nhs> ,
                    <https://lovamap.com/ontology#reagent/10.1039-c6cc05099a/traut-reagent> ,
                    <https://lovamap.com/ontology#reagent/10.1039-c6cc05099a/gsh> ,
                    <https://lovamap.com/ontology#reagent/10.1039-c6cc05099a/heparin> .

<https://lovamap.com/ontology#reagent/10.1039-c6cc05099a/pah> a lova:Reagent ;
    rdfs:label "Poly(allylamine hydrochloride) (PAH)" ;
    lova:reagentRole "monomer" ;
    lova:reagentFunction "Cationic polymer backbone for electrostatic assembly with negatively charged proteins" .

<https://lovamap.com/ontology#reagent/10.1039-c6cc05099a/peg-nhs> a lova:Reagent ;
    rdfs:label "N-hydroxysuccinimide (NHS) ester of poly(ethylene glycol) (PEG-NHS)" ;
    lova:reagentRole "crosslinker" ;
    lova:reagentFunction "PEGylation of PAH to reduce cytotoxicity" .

<https://lovamap.com/ontology#reagent/10.1039-c6cc05099a/traut-reagent> a lova:Reagent ;
    rdfs:label "2-Iminothiolane hydrochloride (Traut's reagent)" ;
    lova:reagentRole "crosslinker" ;
    lova:reagentFunction "Introduces thiol groups onto PAH for subsequent disulfide crosslinking" .

<https://lovamap.com/ontology#reagent/10.1039-c6cc05099a/gsh> a lova:Reagent ;
    rdfs:label "Glutathione (GSH)" ;
    lova:reagentRole "other" ;
    lova:concentration "10 mM" ;
    lova:reagentFunction "Triggers cleavage of disulfide bonds to release encapsulated protein cargo" .

<https://lovamap.com/ontology#reagent/10.1039-c6cc05099a/heparin> a lova:Reagent ;
    rdfs:label "Heparin" ;
    lova:reagentRole "other" ;
    lova:concentration "10 mg ml-1" ;
    lova:reagentFunction "Polyanion challenge agent to test nanocapsule stability / competitive displacement of encapsulated protein" .

<https://lovamap.com/ontology#reagent/10.1039-c6cc05099a/trypsin> a lova:Reagent ;
    rdfs:label "Trypsin" ;
    lova:reagentRole "enzyme" ;
    lova:concentration "0.5 mg ml-1" ;
    lova:reagentFunction "Protease digestion challenge to test nanocapsule protective effect" .

<https://lovamap.com/ontology#reagent/10.1039-c6cc05099a/pepsin> a lova:Reagent ;
    rdfs:label "Pepsin" ;
    lova:reagentRole "enzyme" ;
    lova:concentration "0.5 mg ml-1" ;
    lova:reagentFunction "Protease digestion challenge under acidic conditions (pH 2.7 glycine-HCl buffer)" .

<https://lovamap.com/ontology#reagent/10.1039-c6cc05099a/tmb> a lova:Reagent ;
    rdfs:label "3,3',5,5'-Tetramethylbenzidine (TMB)" ;
    lova:reagentRole "other" ;
    lova:concentration "0.5 mM" ;
    lova:reagentFunction "Colorimetric substrate for HRP activity detection" .

<https://lovamap.com/ontology#reagent/10.1039-c6cc05099a/h2o2> a lova:Reagent ;
    rdfs:label "Hydrogen peroxide (H2O2)" ;
    lova:reagentRole "other" ;
    lova:concentration "10 mM" ;
    lova:reagentFunction "Co-substrate for HRP colorimetric activity assay" .

