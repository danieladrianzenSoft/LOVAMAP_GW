<https://lovamap.com/ontology#reagent/10.1021-mp200171d/ha> a lova:Reagent ;
    rdfs:label "Sodium hyaluronan (60,000 Da)" ;
    lova:reagentRole "monomer" ;
    lova:molecularWeight "60,000 Da" ;
    lova:concentration "2.0 g, 5.28 mmole" ;
    lova:supplier "Genzyme Corporation" ;
    lova:reagentFunction "HA backbone for hydrogel network" .

<https://lovamap.com/ontology#reagent/10.1021-mp200171d/adh> a lova:Reagent ;
    rdfs:label "Adipic dihydrazide (ADH)" ;
    lova:reagentRole "other" ;
    lova:concentration "18.0 g, 105.5 mmole" ;
    lova:reagentFunction "Modification of HA carboxyl groups to hydrazide groups (40.46% of carboxyls modified)" .

<https://lovamap.com/ontology#reagent/10.1021-mp200171d/edc> a lova:Reagent ;
    rdfs:label "1-ethyl-3-[3-dimethylaminopropyl] carbodiimide hydrochloride (EDC)" ;
    lova:reagentRole "other" ;
    lova:concentration "4.0 g, 20 mmole" ;
    lova:reagentFunction "Carbodiimide coupling agent for HA-ADH conjugation" .

<https://lovamap.com/ontology#reagent/10.1021-mp200171d/nhs-ac> a lova:Reagent ;
    rdfs:label "N-Acryloxysuccinimide (NHS-AC)" ;
    lova:reagentRole "other" ;
    lova:concentration "1.33 g, 4.4 mmole" ;
    lova:reagentFunction "Acrylation of HA-ADH hydrazide groups (10% acrylation achieved)" .

<https://lovamap.com/ontology#reagent/10.1021-mp200171d/mmpxl> a lova:Reagent ;
    rdfs:label "MMP-degradable crosslinker peptide (Ac-GCRDGPQGIWGQDRCG-NH2)" ;
    lova:reagentRole "crosslinker" ;
    lova:sequence "GCRDGPQGIWGQDRCG" ;
    lova:supplier "Genescript" ;
    lova:concentration "0.91 mg per gel aliquot" ;
    lova:reagentFunction "MMP-degradable inter-chain crosslinking of HA-RGD hydrogel" .

<https://lovamap.com/ontology#reagent/10.1021-mp200171d/rgd> a lova:Reagent ;
