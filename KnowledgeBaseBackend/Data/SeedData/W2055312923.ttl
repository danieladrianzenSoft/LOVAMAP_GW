    lova:annealingConditions "Monitored via release of 2-pyridinethione at 342 nm, reaction reached plateau after ~2 h" ;
    lova:hasReagent <https://lovamap.com/ontology#reagent/10.1021-bc060284y/peg45-monomethyl-ether> ,
