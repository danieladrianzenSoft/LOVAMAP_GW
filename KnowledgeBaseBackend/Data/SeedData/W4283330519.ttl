<https://lovamap.com/ontology#paper/10.1002-adma.202201921> a bibo:AcademicArticle ;
    rdfs:label "Wilson et al., 2022 — Stoichiometric Post-Modification of HA MAP Scaffolds" ;
    dc1:bibliographicCitation "Wilson et al., 2022" ;
    dc1:creator <https://lovamap.com/ontology#author/kelly-sean>,
        <https://lovamap.com/ontology#author/lesher-perez-sasha>,
        <https://lovamap.com/ontology#author/naffaa-moawiah>,
        <https://lovamap.com/ontology#author/segura-tatiana>,
        <https://lovamap.com/ontology#author/wilson-katrina> ;
    dc1:date "2022"^^xsd:gYear ;
    dc1:identifier "10.1002/adma.202201921" ;
    dc1:title "Stoichiometric Post-Modification of Hydrogel Microparticles Dictates Neural Stem Cell Fate in Microporous Annealed Particle Scaffolds" ;
    dc1:type "Research Article" ;
    bibo:authorList ( <https://lovamap.com/ontology#author/wilson-katrina> <https://lovamap.com/ontology#author/lesher-perez-sasha> <https://lovamap.com/ontology#author/naffaa-moawiah> <https://lovamap.com/ontology#author/kelly-sean> <https://lovamap.com/ontology#author/segura-tatiana> ) ;
    lova:focusMaterial "Hyaluronic acid-norbornene (HA-NB) microgels assembled into microporous annealed particle (MAP) scaffolds via tetrazine–norbornene click chemistry, post-modified stoichiometrically with laminin-derived peptides (IKVAV, YIGSR, RGD) to control neural progenitor cell fate" ;
    schema:isPartOf <https://lovamap.com/ontology#journal/advanced-materials> .

