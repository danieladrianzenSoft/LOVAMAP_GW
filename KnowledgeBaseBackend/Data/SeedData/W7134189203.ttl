<https://lovamap.com/ontology#outcome/10.1002-ppsc.202500163/eq1-surface-area> a lova:Outcome ;
    lova:fromExperiment <https://lovamap.com/ontology#experiment/10.1002-ppsc.202500163/interior-pore-size-regression> ;
    dc:source <https://lovamap.com/ontology#paper/10.1002-ppsc.202500163> ;
    rdfs:label "Regression for median pore surface area (µm²/1000) vs δ√ϕ" ;
    lova:measurementType "Median pore surface area" ;
    lova:measurementCategory "Geometric" ;
    lova:valueString "y = 0.00356x² - 0.0345, where x = δ√ϕ (R²=0.9381, NRMSE test a=0.0355)" ;
    lova:scope "Bulk/global" ;
    lova:dataSource "[TEXT]" .

