<https://lovamap.com/ontology#fabrication-method/10.1002-adma.201101771/nanocapsule-synthesis> a lova:FabricationMethod ;
    dc:source <https://lovamap.com/ontology#paper/10.1002-adma.201101771> ;
    rdfs:label "In situ free-radical polymerization encapsulation of protein molecules" ;
    lova:chemistry "Free-radical polymerization" ;
    lova:manufacturingMethod "Electrostatic/hydrogen-bonding enrichment of charged monomers and crosslinkers around protein surface followed by in situ free-radical polymerization forming a thin polymer shell" ;
    lova:annealingConditions "90-120 min, nitrogen atmosphere, 4°C" ;
    lova:hasReagent <https://lovamap.com/ontology#reagent/10.1002-adma.201101771/apm> ,
                    <https://lovamap.com/ontology#reagent/10.1002-adma.201101771/aam> ,
                    <https://lovamap.com/ontology#reagent/10.1002-adma.201101771/bis> ,
                    <https://lovamap.com/ontology#reagent/10.1002-adma.201101771/knrvk-peptide> ,
                    <https://lovamap.com/ontology#reagent/10.1002-adma.201101771/klgpak-peptide> ,
                    <https://lovamap.com/ontology#reagent/10.1002-adma.201101771/aps> ,
                    <https://lovamap.com/ontology#reagent/10.1002-adma.201101771/temed> ,
                    <https://lovamap.com/ontology#reagent/10.1002-adma.201101771/hs-peg-sh> ,
                    <https://lovamap.com/ontology#reagent/10.1002-adma.201101771/dtnb> ,
                    <https://lovamap.com/ontology#reagent/10.1002-adma.201101771/sodium-bicarbonate-buffer> ,
                    <https://lovamap.com/ontology#reagent/10.1002-adma.201101771/phosphate-buffer> ,
                    <https://lovamap.com/ontology#reagent/10.1002-adma.201101771/bsa-protein> ,
                    <https://lovamap.com/ontology#reagent/10.1002-adma.201101771/vegf-protein> .

<https://lovamap.com/ontology#reagent/10.1002-adma.201101771/apm> a lova:Reagent ;
    rdfs:label "N-(3-aminopropyl) methacrylamide (APM)" ;
    lova:reagentRole "monomer" ;
    lova:concentration "10 mg mL-1 aqueous solution" ;
    lova:reagentFunction "Positively charged monomer, controls nanocapsule surface charge" .

<https://lovamap.com/ontology#reagent/10.1002-adma.201101771/aam> a lova:Reagent ;
    rdfs:label "Acrylamide (AAm)" ;
    lova:reagentRole "monomer" ;
    lova:reagentFunction "Neutral monomer" .

<https://lovamap.com/ontology#reagent/10.1002-adma.201101771/bis> a lova:Reagent ;
    rdfs:label "N,N'-methylene bisacrylamide (BIS)" ;
    lova:reagentRole "crosslinker" ;
    lova:reagentFunction "Non-degradable crosslinker" .

<https://lovamap.com/ontology#reagent/10.1002-adma.201101771/knrvk-peptide> a lova:Reagent ;
    rdfs:label "Bisacryloylated plasmin-specific peptide (Lys-Asn-Arg-Val-Lys, KNRVK)" ;
    lova:reagentRole "crosslinker" ;
    lova:sequence "KNRVK" ;
    lova:reagentFunction "Plasmin-cleavable (degradable) crosslinker" .

<https://lovamap.com/ontology#reagent/10.1002-adma.201101771/klgpak-peptide> a lova:Reagent ;
    rdfs:label "Bisacryloylated MMP-cleavable peptide (Lys-Leu-Gly-Pro-Ala-Lys, KLGPAK)" ;
    lova:reagentRole "crosslinker" ;
    lova:sequence "KLGPAK" ;
    lova:reagentFunction "MMP-cleavable (degradable) crosslinker" .

<https://lovamap.com/ontology#reagent/10.1002-adma.201101771/aps> a lova:Reagent ;
    rdfs:label "Ammonium persulfate" ;
    lova:reagentRole "initiator" ;
    lova:concentration "1:10 molar ratio to total monomers" ;
    lova:reagentFunction "Free-radical polymerization initiator" .

<https://lovamap.com/ontology#reagent/10.1002-adma.201101771/temed> a lova:Reagent ;
    rdfs:label "N,N,N',N'-tetramethylethylenediamine (TEMED)" ;
    lova:reagentRole "initiator" ;
    lova:concentration "10% solution" ;
    lova:reagentFunction "Polymerization accelerator/initiator" .

<https://lovamap.com/ontology#reagent/10.1002-adma.201101771/hs-peg-sh> a lova:Reagent ;
    rdfs:label "HS-(CH2CH2O)75-SH (HS-PEG-SH)" ;
    lova:reagentRole "crosslinker" ;
    lova:reagentFunction "Dithiol crosslinker for Michael addition hydrogel formation; used to test protein disulfide bond protection" .

<https://lovamap.com/ontology#reagent/10.1002-adma.201101771/dtnb> a lova:Reagent ;
    rdfs:label "5,5'-dithio-bis(2-nitrobenzoic acid) (DTNB, Ellman's reagent)" ;
    lova:reagentRole "other" ;
    lova:reagentFunction "Quantification of free thiol groups (Ellman's test)" .

<https://lovamap.com/ontology#reagent/10.1002-adma.201101771/sodium-bicarbonate-buffer> a lova:Reagent ;
    rdfs:label "Sodium bicarbonate buffer, 10 mM, pH 8.5" ;
    lova:reagentRole "solvent" ;
    lova:concentration "10 mM, pH 8.5" .

<https://lovamap.com/ontology#reagent/10.1002-adma.201101771/phosphate-buffer> a lova:Reagent ;
